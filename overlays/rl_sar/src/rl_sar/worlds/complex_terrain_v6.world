      </link>
    </model>

    <!-- ============================================================
         STAIRCASE WALLS  (continuous L-shape, RIGHT side)
         Updated for wider stairs (3m) and new landing positions:

         South wall:  y=-1.60, x=[3.0, 8.5]  h=3.0m
         East wall:   x= 8.60, y=[-1.5, 4.5] h=4.5m
         Corner fill: (8.60, -1.60)           h=4.5m
    ============================================================ -->
    <model name="staircase_walls">
      <static>true</static>
      <link name="walls_link">

        <!-- South wall: right of A + south edge of Landing1        -->
        <!-- inner face y=-1.5, outer y=-1.7, x=3.0→8.5 (len 5.5m) -->
        <visual name="sw_south_v">
          <pose>5.75 -1.60 1.50 0 0 0</pose>
          <geometry><box><size>5.5 0.20 3.00</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.55 0.55 0.60 1</ambient></material>
        </visual>
        <collision name="sw_south_c">
          <pose>5.75 -1.60 1.50 0 0 0</pose>
          <geometry><box><size>5.5 0.20 3.00</size></box></geometry>
        </collision>

        <!-- East wall: east of Landing1 + right of B              -->
        <!-- inner face x=8.5, outer x=8.7, y=-1.5→4.5 (len 6.0m) -->
        <visual name="sw_east_v">
          <pose>8.60 1.50 2.25 0 0 0</pose>
          <geometry><box><size>0.20 6.00 4.50</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.55 0.55 0.60 1</ambient></material>
        </visual>
        <collision name="sw_east_c">
          <pose>8.60 1.50 2.25 0 0 0</pose>
          <geometry><box><size>0.20 6.00 4.50</size></box></geometry>
        </collision>

        <!-- Corner filler (fills gap between south & east wall tips) -->
        <visual name="sw_corner_v">
          <pose>8.60 -1.60 2.25 0 0 0</pose>
          <geometry><box><size>0.20 0.20 4.50</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.55 0.55 0.60 1</ambient></material>
        </visual>
        <collision name="sw_corner_c">
          <pose>8.60 -1.60 2.25 0 0 0</pose>
          <geometry><box><size>0.20 0.20 4.50</size></box></geometry>
        </collision>

      </link>
    </model>

    <!-- ============================================================
         2ND FLOOR TOP PLATFORM + LANDMARK FEATURES
         x=[3,15]  y=[5.5,17]  z=3.0m
         11 landmark features for 3D navigation mapping
    ============================================================ -->
    <model name="top_platform_2f">
      <static>true</static>
      <link name="top_link">

