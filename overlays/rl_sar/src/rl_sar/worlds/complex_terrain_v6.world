        <visual name="sC3_v"><pose>7.0 18.05 3.525 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.83 0.83 0.83 1</ambient></material></visual>
        <collision name="sC3_c"><pose>7.0 18.05 3.525 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
