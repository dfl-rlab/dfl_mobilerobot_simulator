<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="complex_terrain_v6">

    <!-- ============================================================
         PHYSICS
    ============================================================ -->
    <physics type="ode">
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>2000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ============================================================
         SCENE: higher ambient so environment is bright from start
    ============================================================ -->
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.25 0.25 0.25 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ============================================================
         LIGHTS
         4 directional lights from different angles replace the
         default dim sun, so the world is bright on first open.
         Shadows disabled to avoid GPU stutter.
    ============================================================ -->
    <!-- Main top-down sun -->
    <light name="sun_main" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.90 0.90 0.90 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>-0.3 0.1 -1.0</direction>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>



    <!-- Custom ground: same colour as 2F/3F platforms (0.62 0.62 0.68) -->
    <model name="custom_ground">
      <static>true</static>
      <link name="ground_link">
        <visual name="ground_v">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>100 80 0.10</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.48 1</ambient>
            <diffuse>0.45 0.45 0.48 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <collision name="ground_c">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>100 80 0.10</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         STAIRCASE COMPLEX  v4
         ─────────────────────────────────────────────────────────
         Width change:  2.0 m  →  3.0 m  (100 cm wider)
         New staircase: C  (3rd floor, z 3.0 → 4.5 m, +Y from y=17)

         Geometry summary (all stairs: step depth=0.30m, rise=0.15m)

         Staircase A : +X dir, width 3m (y=[-1.5,+1.5])
                       steps x= 3.15..5.85,  z_top = 0.15..1.50m
         Landing 1   : center (7,0,1.425)  size 3×3×0.15
                       x=[5.5,8.5]  y=[-1.5,+1.5]  z_top=1.50m
         Staircase B : +Y dir, width 3m (x=[5.5,8.5])
                       steps y= 1.65..4.35,  z_top = 1.65..3.00m
         Landing 2   : center (7,5.0,2.925) size 3×1×0.15
                       y=[4.5,5.5]  z_top=3.00m
         Top platform: x=[3,15]  y=[5.5,17]  z=3.00m

         Staircase C : +Y dir, width 3m (x=[5.5,8.5])
                       steps y=17.15..19.85  z_top=3.15..4.50m
         Landing 3   : center (7,20.5,4.425) size 3×1×0.15
                       y=[20,21]  z_top=4.50m
         3F platform : x=[3,11]  y=[21,29]  z=4.50m
    ============================================================ -->
    <model name="staircase_complex">
      <static>true</static>
      <link name="stairs_link">

        <!-- ── STAIRCASE A (3m wide in Y) ─────────────────────── -->
        <visual name="sA0_v"><pose>3.15 0 0.075 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sA0_c"><pose>3.15 0 0.075 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry></collision>
        <visual name="sA1_v"><pose>3.45 0 0.225 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sA1_c"><pose>3.45 0 0.225 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry></collision>
        <visual name="sA2_v"><pose>3.75 0 0.375 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sA2_c"><pose>3.75 0 0.375 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry></collision>
        <visual name="sA3_v"><pose>4.05 0 0.525 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sA3_c"><pose>4.05 0 0.525 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry></collision>
        <visual name="sA4_v"><pose>4.35 0 0.675 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sA4_c"><pose>4.35 0 0.675 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry></collision>
        <visual name="sA5_v"><pose>4.65 0 0.825 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sA5_c"><pose>4.65 0 0.825 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry></collision>
        <visual name="sA6_v"><pose>4.95 0 0.975 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
