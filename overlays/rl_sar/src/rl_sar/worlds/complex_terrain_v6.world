        <collision name="sB9_c"><pose>7.0 4.35 2.925 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>

        <!-- ── LANDING 2  (3×1m, z=3.0m, y=[4.5,5.5]) ─────────── -->
        <visual name="land2_v"><pose>7.0 5.0 2.925 0 0 0</pose>
          <geometry><box><size>3.0 1.0 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.65 0.65 0.72 1</ambient></material>
        </visual>
        <collision name="land2_c"><pose>7.0 5.0 2.925 0 0 0</pose><geometry><box><size>3.0 1.0 0.15</size></box></geometry></collision>

        <!-- ── STAIRCASE C  (3rd floor, +Y from y=17, z=3→4.5m) ─ -->
        <!-- entry is from the back of the 2nd floor top platform   -->
        <visual name="sC0_v"><pose>7.0 17.15 3.075 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.83 0.83 0.83 1</ambient></material></visual>
        <collision name="sC0_c"><pose>7.0 17.15 3.075 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sC1_v"><pose>7.0 17.45 3.225 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.83 0.83 0.83 1</ambient></material></visual>
        <collision name="sC1_c"><pose>7.0 17.45 3.225 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sC2_v"><pose>7.0 17.75 3.375 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.83 0.83 0.83 1</ambient></material></visual>
