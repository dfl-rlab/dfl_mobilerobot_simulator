        <visual name="sA7_v"><pose>5.25 0 1.125 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sA7_c"><pose>5.25 0 1.125 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry></collision>
        <visual name="sA8_v"><pose>5.55 0 1.275 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sA8_c"><pose>5.55 0 1.275 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry></collision>
        <visual name="sA9_v"><pose>5.85 0 1.425 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sA9_c"><pose>5.85 0 1.425 0 0 0</pose><geometry><box><size>0.30 3.0 0.15</size></box></geometry></collision>

        <!-- ── LANDING 1  (3×3m, z=1.5m) ─────────────────────── -->
        <visual name="land1_v"><pose>7.0 0 1.425 0 0 0</pose>
          <geometry><box><size>3.0 3.0 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.70 0.70 0.75 1</ambient></material>
        </visual>
        <collision name="land1_c"><pose>7.0 0 1.425 0 0 0</pose><geometry><box><size>3.0 3.0 0.15</size></box></geometry></collision>

        <!-- ── STAIRCASE B (3m wide in X, +Y dir) ────────────── -->
        <!-- starts at y=1.65 (after landing1 north edge at y=1.5) -->
        <visual name="sB0_v"><pose>7.0 1.65 1.575 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sB0_c"><pose>7.0 1.65 1.575 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sB1_v"><pose>7.0 1.95 1.725 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sB1_c"><pose>7.0 1.95 1.725 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sB2_v"><pose>7.0 2.25 1.875 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sB2_c"><pose>7.0 2.25 1.875 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sB3_v"><pose>7.0 2.55 2.025 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sB3_c"><pose>7.0 2.55 2.025 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sB4_v"><pose>7.0 2.85 2.175 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sB4_c"><pose>7.0 2.85 2.175 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sB5_v"><pose>7.0 3.15 2.325 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sB5_c"><pose>7.0 3.15 2.325 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sB6_v"><pose>7.0 3.45 2.475 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sB6_c"><pose>7.0 3.45 2.475 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sB7_v"><pose>7.0 3.75 2.625 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sB7_c"><pose>7.0 3.75 2.625 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sB8_v"><pose>7.0 4.05 2.775 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="sB8_c"><pose>7.0 4.05 2.775 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
