        <!-- ── LANDING 3  (3×1m, z=4.5m, y=[20,21]) ─────────── -->
        <visual name="land3_v"><pose>7.0 20.5 4.425 0 0 0</pose>
          <geometry><box><size>3.0 1.0 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.62 0.62 0.70 1</ambient></material>
