        <collision name="sC4_c"><pose>7.0 18.35 3.675 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sC5_v"><pose>7.0 18.65 3.825 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.83 0.83 0.83 1</ambient></material></visual>
        <collision name="sC5_c"><pose>7.0 18.65 3.825 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry></collision>
        <visual name="sC6_v"><pose>7.0 18.95 3.975 0 0 0</pose><geometry><box><size>3.0 0.30 0.15</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.83 0.83 0.83 1</ambient></material></visual>
