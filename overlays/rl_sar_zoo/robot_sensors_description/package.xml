<?xml version="1.0"?>
<package format="3">
  <name>robot_sensors_description</name>
  <version>0.1.0</version>
  <description>Reusable sensor descriptions for ROS 2 and Gazebo Harmonic.</description>
  <maintainer email="fanziqi614@gmail.com">rl_sar contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_rendering_vendor</depend>
  <depend>rclcpp</depend>
